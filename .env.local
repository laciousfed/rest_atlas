# ==============================================================================
# REST ATLAS — LOCAL DEVELOPMENT ENVIRONMENT
# ==============================================================================
# Copy of .env.example populated with safe development defaults.
# The application runs fully in in-memory seed-dataset mode without these keys.
# Fill in real Firebase and Google keys when connecting to live services.

# ------------------------------------------------------------------------------
# 1. CLIENT FIREBASE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_YOUR_APP_ID

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_YOUR_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="REPLACE_WITH_YOUR_PRIVATE_KEY"

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS PLATFORM
# ------------------------------------------------------------------------------
GOOGLE_MAPS_SERVER_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_SERVER_KEY
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_EMBED_KEY

# ------------------------------------------------------------------------------
# 4. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_BOOTSTRAP_SECRET=local_dev_bootstrap_secret_change_in_production
