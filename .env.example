# ==============================================================================
# REST ATLAS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your verified configuration.
# Never commit real private keys or service account credentials into source control.

# ------------------------------------------------------------------------------
# 1. CLIENT FIREBASE CONFIGURATION (Publicly accessible in client bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rest-atlas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rest-atlas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rest-atlas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Strictly private, never in client bundle)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=rest-atlas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rest-atlas.iam.gserviceaccount.com
# For multi-line private keys, wrap in double quotes with \n escaped:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS PLATFORM (Places API & Embeds)
# ------------------------------------------------------------------------------
# Used server-side in /api/integrations/google-places to fetch permitted hotel place details
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyExampleServerSidePlacesKey987654321
# Optional client embed key for Google Maps iframe displays (restricted by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=AIzaSyExampleClientMapsKey123456789

# ------------------------------------------------------------------------------
# 4. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://restatlas.com
# Secret token to protect the initial admin bootstrap endpoint
ADMIN_BOOTSTRAP_SECRET=create_a_secure_random_token_here_at_least_32_characters
